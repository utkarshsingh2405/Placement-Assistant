# ==============================================================================
# Placement Assistant Platform - Environment Configuration Reference
# ==============================================================================
# Copy this file to .env to override defaults for local development or cloud hosting.

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
# PORT is assigned dynamically by cloud providers (Railway, Render, Heroku) or defaults to 8080 (fallback to 8088 if busy).
PORT=8080

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8088

# ------------------------------------------------------------------------------
# 2. Database Engine & Storage
# ------------------------------------------------------------------------------
# Options: 'sqlite' (zero-config pre-seeded embedded database) | 'prod' (Postgres/MySQL)
SPRING_PROFILES_ACTIVE=sqlite

# Unified SQLite Database Path
DB_PATH=database/placement_assist.db

# Storage / Upload Directories
PORTAL_UPLOAD_DIR=./data/portal/uploads
INSTITUTE_UPLOAD_DIR=./data/institute/uploads/resumes
PLACEMENT_UPLOAD_DIR=./data/placement/uploads

# ------------------------------------------------------------------------------
# 3. Security, SSO & JWT
# ------------------------------------------------------------------------------
# Secret key for JWT HS512 signing (must be at least 32 bytes / 64 hex characters)
# Generate a fresh secret in production with: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_MINUTES=1440
JWT_REFRESH_DAYS=7

# Internal Service / Integration API Key
INSTITUTE_API_KEY=inst-sec-key-7f9a12b4e8c345d6

# ------------------------------------------------------------------------------
# 4. Web Push & Notifications (Optional)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
VAPID_PRIVATE_KEY=UUxP9kI1j0qU4M-2M2jCq5U1c7L3J4p4V1c7L3J4p4U
VAPID_SUBJECT=mailto:admin@placementassist.edu

# Mail & Notifications (log | smtp)
MAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@placementassist.edu
SMTP_PASS=app-specific-password
MAIL_FROM=notifications@placementassist.edu
