# ==============================================================================
# Placement Assistant Platform - Environment Configuration Reference
# ==============================================================================
# Copy this file to .env to override defaults for local development or cloud hosting.

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
# PORT is assigned dynamically by cloud providers (Railway, Render, Heroku).
PORT=8080
PORTAL_PORT=8080
INSTITUTE_PORT=8081
PLACEMENT_PORT=8082

# Internal Pillar Base URLs (used by Portal Gateway reverse proxy)
PORTAL_URL=http://localhost:8080
INSTITUTE_URL=http://localhost:8081
PLACEMENT_URL=http://localhost:8082

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8088

# ------------------------------------------------------------------------------
# 2. Database Engine & Storage
# ------------------------------------------------------------------------------
# Options: 'sqlite' (zero-config pre-seeded embedded databases) | 'dev' (MySQL)
SPRING_PROFILES_ACTIVE=sqlite

# SQLite Database Paths (relative or absolute)
DB_PATH=database/portal.db
DB_INSTITUTE_PATH=database/institute.db
DB_PLACEMENT_PATH=database/placement.db

# MySQL Configuration (only required when SPRING_PROFILES_ACTIVE=dev)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE_PORTAL=placement_portal
MYSQL_DATABASE_INSTITUTE=placement_institute
MYSQL_DATABASE_PLACEMENT=placement_placement

# File Storage / Upload Roots
PORTAL_UPLOAD_DIR=./data/portal/uploads
INSTITUTE_UPLOAD_DIR=./data/institute/uploads/resumes
PLACEMENT_UPLOAD_DIR=./data/placement/uploads

# ------------------------------------------------------------------------------
# 3. Security, SSO & JWT
# ------------------------------------------------------------------------------
PORTAL_SSO_ENABLED=true
# 256-bit Hex secret key for HS256 HMAC signing
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000          # 24 Hours
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 Days

# Inter-Pillar Integration API Key
INSTITUTE_API_KEY=inst-sec-key-7f9a12b4e8c345d6

# ------------------------------------------------------------------------------
# 4. Notifications & Mail Mode
# ------------------------------------------------------------------------------
# Options: 'log' (outputs to console) | 'smtp' (sends real emails)
MAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@placementassist.edu
SMTP_PASS=app-specific-password
MAIL_FROM=notifications@placementassist.edu

# Web Push Notification Keys (VAPID)
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
VAPID_PRIVATE_KEY=UUxP9kI1j0qU4M-2M2jCq5U1c7L3J4p4V1c7L3J4p4U
VAPID_SUBJECT=mailto:admin@placementassist.edu

