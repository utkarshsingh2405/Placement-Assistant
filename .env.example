# ==============================================================================
# Placement Assistant Platform - Environment Configuration Reference
# ==============================================================================
# Copy this file to .env to override defaults for local development or cloud hosting.

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
# PORT is assigned dynamically by cloud providers (Render, Railway) or defaults to 10000.
PORT=10000
SERVER_ADDRESS=0.0.0.0

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8088,http://localhost:10000

# ------------------------------------------------------------------------------
# 2. Database Engine & Storage
# ------------------------------------------------------------------------------
# Active Spring Profile: 'sqlite' (embedded file) or 'mysql' / 'prod'
SPRING_PROFILES_ACTIVE=sqlite

# Configurable SQLite Database Path (Render persistent disk: /data/app.db; Local: database/placement_assist.db)
SQLITE_DB_PATH=database/placement_assist.db
DB_PATH=database/placement_assist.db

# Storage / Upload Directories
STORAGE_UPLOAD_DIR=./uploads/resumes

# ------------------------------------------------------------------------------
# 3. Security, SSO & JWT (REQUIRED)
# ------------------------------------------------------------------------------
# Secret key for JWT HMAC-SHA signing (MUST be at least 32 bytes / 256 bits)
# Generate a fresh secret in production with: openssl rand -hex 32
JWT_SECRET=your_minimum_32_byte_secret_key_here_for_jwt_signing

# Token expiration times
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Internal Service / Integration API Key
INSTITUTE_API_KEY=your_secure_internal_api_key_here

# ------------------------------------------------------------------------------
# 4. Web Push & Notifications (Optional)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:tpo@college.edu

# Mail & Notifications (log | smtp)
MAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@college.edu
SMTP_PASS=app-specific-password
MAIL_FROM=notifications@college.edu
