{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c 'java -Dserver.port=${PORT:-8080} -Dspring.profiles.active=sqlite -DDB_PATH=/app/database/portal.db -DDB_INSTITUTE_PATH=/app/database/institute.db -DDB_PLACEMENT_PATH=/app/database/placement.db -Dpillar.institute.jar=/app/institute.jar -Dpillar.placement.jar=/app/placement.jar -jar /app/portal.jar'",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}

